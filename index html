<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NYUMBANI FRESH BLENDS</title>
<meta name="description" content="Premium Kenyan artisanal spice blends inspired by heritage, purity, and modern luxury.">

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Playfair+Display:ital,wght=0,400;0,700;1,400&display=swap" rel="stylesheet">

<style>
:root{
  --black:#000000;
  --gold:#D4AF37; 
  --terracotta:#8E3E26; 
  --glass:rgba(212,175,55,0.04);
  --glass-border:rgba(212,175,55,0.15);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  background:var(--black);
  color:var(--gold); 
  font-family: 'Playfair Display', serif;
  overflow-x:hidden;
}

.bg{
  position:fixed;
  inset:0;
  background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)), 
              url('https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
  z-index:-2;
}

.ambience-layer {
  position: fixed;
  inset: 0;
  background-size: cover;
  background-position: center;
  z-index: -1;
  opacity: 0.18;
  transition: background-image 0.8s ease-in-out, opacity 0.8s;
}

header{
  position:fixed;
  top:0;
  width:100%;
  z-index:999;
  backdrop-filter:blur(15px);
  -webkit-backdrop-filter:blur(15px);
  background:rgba(0,0,0,0.8);
  border-bottom:1px solid var(--glass-border);
}

.nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 7%;
  flex-wrap: nowrap;
  gap: 15px;
}

.logo{
  display:flex;
  flex-direction:column;
  cursor: pointer;
  text-decoration: none;
}

.logo-main{
  font-family:'Cinzel', serif;
  font-size:1.8rem;
  color:var(--terracotta);
  font-weight:700;
  letter-spacing:2px;
}

.logo-sub{
  letter-spacing:8px;
  font-size:0.6rem;
  text-transform:uppercase;
  color: #888;
}

.nav-links{
  display:flex;
  gap:30px;
}

.nav-links a{
  color:var(--gold);
  text-decoration:none;
  transition:0.3s;
  font-size: 0.95rem;
  cursor: pointer;
  white-space: nowrap;
  font-family: 'Cinzel', serif;
}

.nav-links a:hover, .nav-links a.active-link{
  color:var(--terracotta);
}

.menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 26px;
  height: 18px;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 1001;
}

.menu-toggle span {
  width: 100%;
  height: 2px;
  background-color: var(--gold);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.menu-toggle.open span:nth-child(1) {
  transform: translateY(8px) rotate(45deg);
  background-color: var(--terracotta);
}
.menu-toggle.open span:nth-child(2) {
  opacity: 0;
}
.menu-toggle.open span:nth-child(3) {
  transform: translateY(-8px) rotate(-45deg);
  background-color: var(--terracotta);
}

.side-drawer {
  position: fixed;
  top: 0;
  right: -320px;
  width: 320px;
  height: 100vh;
  background: rgba(5, 5, 5, 0.98); 
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-left: 1px solid var(--glass-border);
  box-shadow: -10px 0 30px rgba(0,0,0,0.9);
  z-index: 1000;
  padding: 120px 40px 40px;
  display: flex;
  flex-direction: column;
  gap: 25px;
  transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
}

.side-drawer.open {
  transform: translateX(-320px);
}

.side-drawer a {
  font-family: 'Cinzel', serif;
  font-size: 1.25rem;
  color: var(--gold);
  text-decoration: none;
  letter-spacing: 1.5px;
  transition: transform 0.3s, color 0.3s;
  padding-bottom: 5px;
  border-bottom: 1px solid rgba(212,175,55,0.05);
  cursor: pointer;
}

.side-drawer a:hover, .side-drawer a.active-link {
  color: var(--terracotta);
  transform: translateX(8px);
}

.drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  pointer-events: none; /* Prevents invisible click blocking */
  transition: opacity 0.4s, visibility 0.4s;
}

.drawer-overlay.visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.page-view {
  display: none;
  animation: fadeInView 0.5s ease-in-out forwards;
}

.page-view.active-view {
  display: block;
}

@keyframes fadeInView {
  from { opacity: 0; transform: scale(0.99) translateY(5px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.section{
  padding:140px 8% 80px;
  min-height: 100vh;
}

.section-title{
  text-align:center;
  margin-bottom:60px;
}

.section-title h2{
  font-family:'Cinzel', serif;
  color:var(--terracotta);
  font-size:3rem;
  margin-bottom:20px;
}

.section-title p{
  color: var(--gold);
  font-style: italic;
}

.hero-editorial {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 0 60px;
}

.hero-text-block h1 {
  font-family: 'Cinzel', serif;
  font-size: 3.5rem;
  color: var(--terracotta);
  line-height: 1.2;
  margin-bottom: 25px;
}

.hero-text-block p {
  line-height: 1.8;
  font-size: 1.15rem;
  margin-bottom: 20px;
  color: var(--gold);
}

.hero-text-block .welcome-badge {
  font-family: 'Cinzel', serif;
  font-size: 1.5rem;
  color: var(--terracotta);
  margin-top: 20px;
  display: block;
  letter-spacing: 2px;
}

.fancy-food-gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.gallery-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--glass-border);
  aspect-ratio: 4/5;
}

.gallery-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  filter: brightness(85%) contrast(105%);
}

.gallery-card:hover img {
  transform: scale(1.08);
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.9) 20%, transparent 80%);
  display: flex;
  align-items: flex-end;
  padding: 20px;
}

.gallery-overlay span {
  font-family: 'Cinzel', serif;
  color: var(--gold);
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.products{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:35px;
}

.spice-card{
  background:rgba(10,10,10,0.8);
  backdrop-filter: blur(5px);
  padding:35px;
  border: 1px solid rgba(142, 62, 38, 0.2);
  transition:0.4s;
  text-align: center;
}

.spice-card:hover{
  transform:translateY(-10px);
  border-color: var(--terracotta);
}

.spice-name-glow {
  font-family: 'Cinzel', serif;
  font-size: 1.6rem;
  color: var(--gold); 
  margin-bottom: 25px;
  display: block;
  text-shadow: 0 0 8px rgba(142, 62, 38, 0.4), 0 0 15px rgba(212,175,55,0.2);
  letter-spacing: 1px;
}

.price-tiers { margin: 15px 0; }
.tier {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid rgba(212,175,55,0.08);
}
.weight-label { color: #888; font-size: 0.85rem; font-style: italic; }
.price-value { color: var(--terracotta); font-weight: 700; }

.order-btn{
  width:100%;
  padding:14px;
  border:1px solid var(--terracotta);
  background:transparent;
  color:var(--terracotta);
  cursor:pointer;
  font-weight:700;
  margin-top: 15px;
  transition: 0.3s;
  font-family: 'Playfair Display', serif;
}
.order-btn:hover { background: var(--terracotta); color: var(--gold); }

.btn{
  display:inline-block;
  padding:16px 34px;
  border-radius:0; 
  background:var(--terracotta);
  color:var(--gold);
  font-weight:700;
  text-decoration:none;
  transition:0.4s;
  border: 1px solid var(--terracotta);
  cursor: pointer;
  font-family: 'Cinzel', serif;
  font-size: 0.85rem;
  letter-spacing: 1px;
}
.btn:hover{
  transform:translateY(-5px);
  background:transparent;
  color:var(--terracotta);
}

.blog-layout { max-width: 850px; margin: 0 auto; }
.blog-intro-box { margin-bottom: 50px; font-size: 1.2rem; line-height: 1.8; }
.blog-item { margin-bottom: 45px; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); padding: 35px; border: 1px solid var(--glass-border); }
.blog-item h3 { font-family: 'Cinzel', serif; color: var(--terracotta); font-size: 1.6rem; margin-bottom: 15px; }
.blog-item ul { list-style: none; margin-bottom: 15px; }
.blog-item ul li { margin-bottom: 10px; line-height: 1.7; }
.blog-closing { text-align: center; margin-top: 60px; padding: 40px; background: rgba(142, 62, 38, 0.05); border: 1px solid rgba(142, 62, 38, 0.2); }
.blog-closing h4 { font-family: 'Cinzel', serif; font-size: 1.6rem; margin-bottom: 15px; }

.contact-container { max-width: 700px; margin: 0 auto; text-align: center; }
.contact-list { margin: 40px 0; display: flex; flex-direction: column; gap: 20px; }
.contact-anchor-card {
  background: rgba(10,10,10,0.8);
  padding: 22px;
  border: 1px solid var(--glass-border);
  font-size: 1.2rem;
  color: var(--gold);
  text-decoration: none;
  display: block;
  transition: 0.3s;
}
.contact-anchor-card:hover {
  border-color: var(--terracotta);
  background: rgba(142, 62, 38, 0.1);
  transform: scale(1.02);
}
.contact-anchor-card strong { font-family: 'Cinzel', serif; color: var(--terracotta); margin-right: 10px; }

.about-container { max-width: 900px; margin: 0 auto; }
.about-purity-title { font-family: 'Cinzel', serif; color: var(--terracotta); font-size: 2.2rem; text-align: center; letter-spacing: 3px; margin-bottom: 40px; }
.about-intro-text p { font-size: 1.2rem; line-height: 1.8; margin-bottom: 25px; }
.about-bullets ul { list-style: none; }
.about-bullets li { background: rgba(255,255,255,0.01); padding: 25px; margin-bottom: 20px; border-left: 3px solid var(--terracotta); line-height: 1.7; border-top: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); }
.about-bullets li strong { font-family: 'Cinzel', serif; color: var(--terracotta); display: block; font-size: 1.1rem; margin-bottom: 5px; }
.about-commitment { font-size: 1.20rem; line-height: 1.8; text-align: center; margin: 40px 0; padding: 30px; border-top: 1px dashed var(--glass-border); border-bottom: 1px dashed var(--glass-border); }

.feedback-workspace {
  max-width: 950px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
}
.comment-form-panel { background: rgba(10,10,10,0.8); padding: 40px; border: 1px solid var(--glass-border); }
.comment-form-panel h3 { font-family: 'Cinzel', serif; color: var(--terracotta); margin-bottom: 20px; font-size: 1.5rem; }
.input-row { margin-bottom: 20px; }
.input-row label { display: block; font-family: 'Cinzel', serif; margin-bottom: 8px; font-size: 0.85rem; letter-spacing: 1px; }
.input-row input, .input-row textarea { width: 100%; background: transparent; border: 1px solid var(--glass-border); padding: 12px; color: var(--gold); font-family: 'Playfair Display', serif; font-size: 1rem; }
.input-row input:focus, .input-row textarea:focus { outline: none; border-color: var(--terracotta); }
.live-reviews-feed { display: flex; flex-direction: column; gap: 20px; max-height: 500px; overflow-y: auto; padding-right: 10px; }
.live-reviews-feed::-webkit-scrollbar { width: 4px; }
.live-reviews-feed::-webkit-scrollbar-thumb { background: var(--terracotta); }
.review-bubble { background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border); padding: 20px; border-left: 2px solid var(--gold); }
.review-bubble .author-mark { font-family: 'Cinzel', serif; color: var(--terracotta); font-size: 0.9rem; margin-bottom: 5px; display: block; }

.faq-box { max-width: 800px; margin: 0 auto; }
.faq-card { background: rgba(10,10,10,0.8); padding: 35px; border: 1px solid var(--glass-border); margin-bottom: 20px; }
.faq-card h3 { font-family: 'Cinzel', serif; color: var(--terracotta); font-size: 1.3rem; margin-bottom: 10px; }

footer{
  padding:40px;
  text-align:center;
  background:rgba(0,0,0,0.9);
  color:#555;
  font-size: 0.8rem;
  letter-spacing: 2px;
  border-top: 1px solid var(--glass-border);
}

.loader{
  position:fixed;
  inset:0;
  background:black;
  display:flex;
  flex-direction: column;
  justify-content:center;
  align-items:center;
  z-index:5000;
  pointer-events: none; /* Allows clicks to pass through immediately */
  animation:fadeOut 1.5s forwards;
  animation-delay:1.5s;
}
.loader-text { font-family: 'Cinzel', serif; color: var(--terracotta); text-align: center; }
.loader-main { font-size: 2.5rem; letter-spacing: 5px; animation: textPulse 2s infinite; }
.loader-sub { font-size: 0.8rem; letter-spacing: 12px; color: #555; }

@keyframes textPulse {
  0%, 100% { opacity: 0.6; text-shadow: 0 0 5px rgba(142,62,38,0.2); }
  50% { opacity: 1; text-shadow: 0 0 20px rgba(142,62,38,0.7); }
}
@keyframes fadeOut{ to{ opacity:0; visibility:hidden; z-index:-1;} }

@media(max-width:900px){
  .nav-links { display: none; }
  .menu-toggle { display: flex; }
  .section { padding: 120px 4% 60px; min-height: auto; }
  .hero-editorial, .feedback-workspace { grid-template-columns: 1fr; gap: 30px; }
  .hero-text-block h1 { font-size: 2.3rem; }
  .fancy-food-gallery { gap: 12px; }
}

@media(max-width:480px) {
  .logo-main { font-size: 1.5rem; }
  .section-title h2 { font-size: 1.8rem; }
  .spice-card { padding: 25px 15px; }
}
</style>
</head>

