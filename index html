<script>
  // Product Data
  const products = [
    { name: "Pure Turmeric", t1: "50g - KES 150", t2: "100g - KES 250" },
    { name: "Garlic Powder", t1: "50g - KES 200", t2: "100g - KES 350" },
    { name: "Ground Ginger", t1: "50g - KES 180", t2: "100g - KES 300" },
    { name: "Pilau Masala", t1: "50g - KES 220", t2: "100g - KES 400" },
    { name: "Black Pepper", t1: "50g - KES 250", t2: "100g - KES 450" }
  ];

  // Render Products
  const grid = document.getElementById('productGrid');
  products.forEach(p => {
    grid.innerHTML += `
      <div class="spice-card">
        <span class="spice-name-glow">${p.name}</span>
        <div class="price-tiers">
          <div class="tier"><span class="weight-label">Small Pack</span><span class="price-value">${p.t1}</span></div>
          <div class="tier"><span class="weight-label">Standard Pack</span><span class="price-value">${p.t2}</span></div>
        </div>
        <button class="order-btn" onclick="navigateToPage('contact-page')">Order Now</button>
      </div>
    `;
  });

  // Navigation Controller
  function navigateToPage(pageId) {
    // Hide all pages
    document.querySelectorAll('.page-view').forEach(page => {
      page.classList.remove('active-view');
    });
    
    // Show active page
    document.getElementById(pageId).classList.add('active-view');
    
    // Update active state on navigation buttons
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.classList.remove('active-link');
      if(btn.getAttribute('data-target') === pageId) {
        btn.classList.add('active-link');
      }
    });

    toggleDrawer(false);
    window.scrollTo(0, 0);
  }

  // Drawer Toggle
  function toggleDrawer(forceState) {
    const drawer = document.getElementById('sideDrawer');
    const overlay = document.getElementById('drawerOverlay');
    const toggleBtn = document.querySelector('.menu-toggle');
    
    const isOpen = forceState !== undefined ? forceState : !drawer.classList.contains('open');
    
    if(isOpen) {
      drawer.classList.add('open');
      overlay.classList.add('visible');
      toggleBtn.classList.add('open');
    } else {
      drawer.classList.remove('open');
      overlay.classList.remove('visible');
      toggleBtn.classList.remove('open');
    }
  }

  // Destroy Loader Element to prevent invisible click shields
  window.addEventListener('load', () => {
    setTimeout(() => {
      const loader = document.querySelector('.loader');
      if(loader) loader.style.display = 'none';
    }, 1600);
  });
</script>

